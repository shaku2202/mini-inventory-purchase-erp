{
  "info": {
    "name": "Mini Inventory & Purchase ERP",
    "description": "Run folders top-to-bottom on a freshly seeded DB (npm run db:seed). Idempotency keys use {{$guid}} so each send is a new action; the \"retry\" requests reuse a fixed key to demonstrate duplicate protection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000/api"
    }
  ],
  "item": [
    {
      "name": "0. Health",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "1. Master data",
      "item": [
        {
          "name": "Create vendor",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/vendors",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "vendors"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"DEMO-VENDOR\",\n  \"name\": \"Demo Glass Supplier\",\n  \"email\": \"demo@vendor.example\",\n  \"phone\": \"+91 90000 00000\"\n}"
            }
          }
        },
        {
          "name": "Create vendor - invalid (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/vendors",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "vendors"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"not-an-email\"\n}"
            }
          }
        },
        {
          "name": "List vendors",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/vendors?search=&page=1&limit=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "vendors"
              ],
              "query": [
                {
                  "key": "search",
                  "value": ""
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            }
          }
        },
        {
          "name": "Create product",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sku\": \"DEMO-GLASS-6MM\",\n  \"name\": \"Demo Clear Glass 6mm\",\n  \"unit\": \"SQM\",\n  \"reorderLevel\": 50\n}"
            }
          }
        },
        {
          "name": "Create product - invalid unit (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sku\": \"BAD\",\n  \"name\": \"Bad\",\n  \"unit\": \"TONS\"\n}"
            }
          }
        },
        {
          "name": "List products",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2. Purchase orders",
      "item": [
        {
          "name": "Create PO",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/purchase-orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "purchase-orders"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vendorId\": 1,\n  \"items\": [\n    {\n      \"productId\": 1,\n      \"quantity\": 100,\n      \"unitPrice\": \"450.50\"\n    },\n    {\n      \"productId\": 4,\n      \"quantity\": \"50.5\",\n      \"unitPrice\": 120\n    }\n  ]\n}"
            }
          }
        },
        {
          "name": "Create PO - negative qty (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/purchase-orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "purchase-orders"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vendorId\": 1,\n  \"items\": [\n    {\n      \"productId\": 1,\n      \"quantity\": -5,\n      \"unitPrice\": 10\n    }\n  ]\n}"
            }
          }
        },
        {
          "name": "Create PO - unknown vendor (404)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/purchase-orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "purchase-orders"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vendorId\": 9999,\n  \"items\": [\n    {\n      \"productId\": 1,\n      \"quantity\": 1,\n      \"unitPrice\": 10\n    }\n  ]\n}"
            }
          }
        },
        {
          "name": "List POs",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/purchase-orders?status=&page=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "purchase-orders"
              ],
              "query": [
                {
                  "key": "status",
                  "value": ""
                },
                {
                  "key": "page",
                  "value": "1"
                }
              ]
            }
          }
        },
        {
          "name": "Get PO 1",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/purchase-orders/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "purchase-orders",
                "1"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "3. Goods receipt",
      "item": [
        {
          "name": "Receive 60 (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "postman-grn-retry-demo"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/goods-receipts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "goods-receipts"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"purchaseOrderId\": 1,\n  \"items\": [\n    {\n      \"purchaseOrderItemId\": 1,\n      \"quantity\": 60\n    }\n  ]\n}"
            }
          }
        },
        {
          "name": "Retry same key (200 replay, no stock change)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "postman-grn-retry-demo"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/goods-receipts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "goods-receipts"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"purchaseOrderId\": 1,\n  \"items\": [\n    {\n      \"purchaseOrderItemId\": 1,\n      \"quantity\": 60\n    }\n  ]\n}"
            }
          }
        },
        {
          "name": "Same key, different payload (409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "postman-grn-retry-demo"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/goods-receipts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "goods-receipts"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"purchaseOrderId\": 1,\n  \"items\": [\n    {\n      \"purchaseOrderItemId\": 1,\n      \"quantity\": 5\n    }\n  ]\n}"
            }
          }
        },
        {
          "name": "Over-receipt (422)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/goods-receipts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "goods-receipts"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"purchaseOrderId\": 1,\n  \"items\": [\n    {\n      \"purchaseOrderItemId\": 1,\n      \"quantity\": 1000\n    }\n  ]\n}"
            }
          }
        },
        {
          "name": "Zero qty (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/goods-receipts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "goods-receipts"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"purchaseOrderId\": 1,\n  \"items\": [\n    {\n      \"purchaseOrderItemId\": 1,\n      \"quantity\": 0\n    }\n  ]\n}"
            }
          }
        },
        {
          "name": "List GRNs of PO 1",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/goods-receipts?purchaseOrderId=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "goods-receipts"
              ],
              "query": [
                {
                  "key": "purchaseOrderId",
                  "value": "1"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "4. Inventory",
      "item": [
        {
          "name": "Stock levels",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/inventory?lowStockOnly=false",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "inventory"
              ],
              "query": [
                {
                  "key": "lowStockOnly",
                  "value": "false"
                }
              ]
            }
          }
        },
        {
          "name": "Stock ledger product 1",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/inventory/1/movements",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "inventory",
                "1",
                "movements"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "5. Payable & payments",
      "item": [
        {
          "name": "Vendor 1 balance",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/vendors/1/balance",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "vendors",
                "1",
                "balance"
              ]
            }
          }
        },
        {
          "name": "All vendor balances",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/vendors/balances",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "vendors",
                "balances"
              ]
            }
          }
        },
        {
          "name": "Pay 10000 against PO 1 (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/vendor-payments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "vendor-payments"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vendorId\": 1,\n  \"purchaseOrderId\": 1,\n  \"amount\": \"10000\",\n  \"paymentMethod\": \"BANK_TRANSFER\",\n  \"referenceNo\": \"UTR0001\"\n}"
            }
          }
        },
        {
          "name": "Overpay (422)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/vendor-payments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "vendor-payments"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vendorId\": 1,\n  \"amount\": \"999999\",\n  \"paymentMethod\": \"UPI\"\n}"
            }
          }
        },
        {
          "name": "Pay vendor with nothing owed (422)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/vendor-payments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "vendor-payments"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vendorId\": 3,\n  \"amount\": \"10\",\n  \"paymentMethod\": \"CASH\"\n}"
            }
          }
        },
        {
          "name": "List payments",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/vendor-payments?vendorId=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "vendor-payments"
              ],
              "query": [
                {
                  "key": "vendorId",
                  "value": "1"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}
