# ---- Server ----
NODE_ENV=development
PORT=4000
# Comma separated list of allowed browser origins (the SvelteKit app)
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info

# ---- PostgreSQL ----
# Never commit real credentials. Copy this file to .env and fill in values.
DATABASE_URL=postgres://erp_user:change_me@localhost:5433/erp_db
# Used only by `npm test` (the test suite truncates all tables in this database!)
TEST_DATABASE_URL=postgres://erp_user:change_me@localhost:5433/erp_test
# Set to true for managed Postgres providers (Neon, Supabase, Render, ...)
DATABASE_SSL=false
DB_POOL_MAX=10

# ---- Optional: password for `npm run db:local` (embedded PostgreSQL for dev) ----
LOCAL_PG_PASSWORD=change_me
